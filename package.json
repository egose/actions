{
  "name": "actions",
  "private": true,
  "version": "0.27.0",
  "description": "Reusable composite GitHub Actions for Egose repositories.",
  "homepage": "https://github.com/egose/actions",
  "repository": {
    "type": "git",
    "url": "https://github.com/egose/actions.git"
  },
  "bugs": {
    "url": "https://github.com/egose/actions/issues"
  },
  "keywords": [
    "github-actions",
    "composite-actions",
    "ci",
    "automation"
  ],
  "author": "Junmin Ahn",
  "license": "Apache-2.0",
  "scripts": {
    "actionlint": "actionlint",
    "pre-commit": "pre-commit run --all-files",
    "precommit": "npm run pre-commit",
    "lint": "npm run actionlint && npm run pre-commit",
    "test:shell": "bash tests/test-confluence.sh && bash tests/test-compose-sandbox.sh && bash tests/test-install-packages.sh && bash tests/test-release-tag.sh",
    "release": "release-it",
    "changelog": "repo-toolkit-changelog"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@release-it/bumper": "^8.0.0",
    "@repo-toolkit/changelog": "^0.18.0",
    "@repo-toolkit/compose-sandbox": "^0.18.0",
    "@repo-toolkit/confluence": "^0.18.0",
    "release-it": "^21.0.2"
  }
}
